CREATE TYPE user_role AS ENUM ('customer', 'driver', 'super_admin');

CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL, -- Di-hash menggunakan bcrypt
    phone_number VARCHAR(15) NOT NULL,
    role user_role DEFAULT 'customer',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE fleets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    plate_number VARCHAR(15) UNIQUE NOT NULL, -- Contoh: Z 1234 TF
    car_type VARCHAR(50) NOT NULL,            -- Contoh: Toyota HiAce, Isuzu Elf
    seat_capacity INT NOT NULL DEFAULT 8,     -- Jumlah kursi otomatis (misal: 8)
    status VARCHAR(20) DEFAULT 'active',      -- active, maintenance
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE routes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    origin VARCHAR(50) NOT NULL,       -- Contoh: Ciamis
    destination VARCHAR(50) NOT NULL,  -- Contoh: Jakarta
    base_price DECIMAL(10, 2) NOT NULL,-- Harga dasar per kursi
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE schedules (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    route_id UUID REFERENCES routes(id) ON DELETE CASCADE,
    fleet_id UUID REFERENCES fleets(id) ON DELETE SET NULL,
    driver_id UUID REFERENCES users(id) ON DELETE SET NULL, -- Role harus 'driver'
    departure_time TIMESTAMP NOT NULL,                      -- Tanggal & Jam jalan
    status VARCHAR(20) DEFAULT 'scheduled',                 -- scheduled, board, driving, completed, cancelled
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE travel_bookings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,    -- Customer yang memesan
    schedule_id UUID REFERENCES schedules(id) ON DELETE CASCADE,
    seat_number INT NOT NULL,                               -- Nomor kursi yang dipilih (1-8)
    booking_status VARCHAR(20) DEFAULT 'pending',          -- pending, locked, paid, cancelled
    payment_proof_url VARCHAR(255),                         -- Bukti transfer manual
    locked_until TIMESTAMP,                                 -- Untuk logic Seat Locking (10 menit)
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE charter_bookings (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    destination VARCHAR(255) NOT NULL,
    departure_date DATE NOT NULL,
    return_date DATE NOT NULL,
    notes TEXT,                                              -- Catatan tambahan dari customer
    offered_price DECIMAL(10, 2) DEFAULT NULL,               -- Diisi manual oleh Super Admin nanti
    status VARCHAR(20) DEFAULT 'pending',                    -- pending, priced_offered, paid, completed, rejected
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE package_shipments (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE SET NULL,     -- Pengirim (jika terdaftar)
    sender_name VARCHAR(100) NOT NULL,
    sender_phone VARCHAR(15) NOT NULL,
    receiver_name VARCHAR(100) NOT NULL,
    receiver_phone VARCHAR(15) NOT NULL,
    receiver_address TEXT NOT NULL,
    waybill_number VARCHAR(50) UNIQUE NOT NULL,               -- Nomor resi otomatis (NanoID/UUID pendek)
    package_description TEXT NOT NULL,
    status VARCHAR(20) DEFAULT 'received',                    -- received, sorting, manifesting, on_transit, delivered
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TYPE cashflow_type AS ENUM ('income', 'expense');

CREATE TABLE cashflows (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    amount DECIMAL(10, 2) NOT NULL,
    type cashflow_type NOT NULL,
    category VARCHAR(50) NOT NULL,    -- Contoh: 'travel_ticket', 'fuel', 'toll', 'service'
    description TEXT,                 -- Detail catatan
    reference_id UUID DEFAULT NULL,   -- Bisa dihubungkan ke ID travel_bookings atau charter_bookings jika itu tipe 'income'
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);