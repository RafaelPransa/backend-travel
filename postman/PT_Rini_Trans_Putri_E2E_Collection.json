            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"driving\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/driver/schedules/{{schedule_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "schedules",
                "{{schedule_id}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Status Transit Paket (sorting)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Update Status Transit Sukses\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "status",
                  "value": "sorting",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/packages/shipments/{{package_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "packages",
                "shipments",
                "{{package_id}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Selesaikan Pengiriman Paket & Unggah Bukti Cash",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Penyelesaian Paket Berhasil\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "status",
                  "value": "delivered",
                  "type": "text"
                },
                {
                  "key": "proof_image",
                  "description": "Foto bukti struk/kuitansi penyerahan cash (Pilih file gambar sampel di Postman)",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/packages/shipments/{{package_id}}/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "packages",
                "shipments",
                "{{package_id}}",
                "status"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cari Riwayat Tugas Supir",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cari Riwayat Tugas Sukses\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{driver_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driver/schedules?history=true",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driver",
                "schedules"
              ],
              "query": [
                {
                  "key": "history",
                  "value": "true"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05. Validasi Akhir Admin",
      "item": [
        {
          "name": "Cari Penugasan Armada Selesai Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Ambil Penugasan Selesai Sukses\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.length).to.be.above(0);",
                  "    var verifiedTask = jsonData.data.find(t => t.id === pm.environment.get(\"schedule_id\"));",
                  "    pm.expect(verifiedTask).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/assignments?phase=completed",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "assignments"
              ],
              "query": [
                {
                  "key": "phase",
                  "value": "completed"
                }
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
