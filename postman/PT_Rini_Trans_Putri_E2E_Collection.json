    {
      "name": "02. Area Pelanggan",
      "item": [
        {
          "name": "Kirim Paket (Bayar Cash)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Kirim Paket Berhasil - Status 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"package_id\", jsonData.data.id);",
                  "    pm.environment.set(\"waybill_number\", jsonData.data.waybill_number);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sender_name\": \"Pengirim E2E\",\n  \"sender_phone\": \"081234567890\",\n  \"pickup_address\": \"Desa Panawangan, Dusun Cililitan, RT 01 / RW 02, Kec. Panawangan, Patokan: Dekat Masjid Jami\",\n  \"receiver_name\": \"Penerima E2E\",\n  \"receiver_phone\": \"087777777777\",\n  \"receiver_address\": \"Dusun Cililitan RT 02 RW 03, Desa Panawangan, Ciamis, Jawa Barat\",\n  \"package_description\": \"Dokumen Penting & Pakaian\",\n  \"weight\": 5,\n  \"dimension\": \"kecil\",\n  \"payment_method\": \"cash\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/packages/shipments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "packages",
                "shipments"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Area Admin",
      "item": [
        {
          "name": "Dapatkan Daftar Supir Master",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Ambil Supir Master Berhasil\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    var driver = jsonData.data.find(u => u.role === 'driver' && u.email === 'asep@gmail.com');",
                  "    if(!driver) driver = jsonData.data.find(u => u.role === 'driver');",
                  "    pm.expect(driver).to.not.be.undefined;",
                  "    pm.environment.set(\"driver_id\", driver.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/master/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "master",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Dapatkan Daftar Armada Master",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Ambil Armada Master Berhasil\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    var fleet = jsonData.data[0];",
                  "    pm.expect(fleet).to.not.be.undefined;",
                  "    pm.environment.set(\"fleet_id\", fleet.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/master/fleets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "master",
                "fleets"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cari Penugasan Armada (Butuh Penugasan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Ambil Penugasan Pending Berhasil\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    var task = jsonData.data.find(t => t.type === 'RUTE' && !t.driver_id);",
                  "    pm.expect(task).to.not.be.undefined;",
                  "    pm.environment.set(\"schedule_id\", task.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/assignments?phase=pending",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "assignments"
              ],
              "query": [
                {
                  "key": "phase",
                  "value": "pending"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Tugaskan Supir & Armada ke Perjalanan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Penugasan Sukses\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fleet_id\": \"{{fleet_id}}\",\n  \"driver_id\": \"{{driver_id}}\",\n  \"driver_2_id\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/assignments/RUTE/{{schedule_id}}/assign",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "assignments",
                "RUTE",
                "{{schedule_id}}",
                "assign"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Area Supir",
      "item": [
        {
          "name": "Lihat Jadwal Perjalanan Aktif Supir",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
